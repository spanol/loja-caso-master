# Copie este arquivo para ".env" e preencha antes de subir o container.

PORT=3000
# Interface em que o container publica a porta. Padrao 0.0.0.0 (todas). Num
# servidor com varios servicos, defina o IP da sua tailnet (ex: 100.x.x.x)
# para nao expor a loja tambem na rede local/LAN.
BIND_ADDR=0.0.0.0
# URL publica pela qual os compradores vao acessar a loja (usada nos links de
# e-mail e no botao de download). Se for expor via Tailscale Funnel, use a URL
# https que o Funnel gerar. Sem HTTPS publico, use a URL da sua tailnet mesmo,
# so quem estiver na sua rede Tailscale vai conseguir abrir.
BASE_URL=http://localhost:3000

# Segredo usado para assinar os links de download. Troque por uma string
# aleatoria longa (ex: gere com `openssl rand -hex 32`).
TOKEN_SECRET=troque-este-segredo-antes-de-ir-para-producao

# Quantas horas um link de download liberado fica valido.
LINK_VALID_HOURS=48

# Login do painel /admin (onde voce confere comprovantes e libera pedidos).
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Sua chave Pix (CPF, CNPJ, e-mail, telefone ou chave aleatoria) e os dados
# que aparecem para o comprador no QR code. Nome ate 25 caracteres, cidade ate
# 15 (o sistema corta automaticamente se passar).
PIX_KEY=
PIX_NAME=SEU NOME AQUI
PIX_CITY=SUA CIDADE

# Precos de cada camada, em reais. Pode deixar em branco para usar o padrao
# definido em lib/config.js.
PRICE_TIER1=11.99
PRICE_TIER2=20.87
PRICE_TIER3=43.08

# Opcional: envio automatico do link de download por e-mail quando voce clica
# em "Liberar" no painel. Se deixar em branco, o link so aparece no painel
# admin para voce copiar e mandar manualmente (WhatsApp, por exemplo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
